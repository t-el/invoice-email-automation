# Copy to .env. Defaults run fully offline against the sample inbox.
DATA_DIR=data
LOG_FORMAT=json

# Source: folder (watch a directory of .eml files) | imap
SOURCE=folder
INBOX_DIR=data/inbox
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
# For Gmail/Outlook use an app password, never your main password
IMAP_PASSWORD=
IMAP_FOLDER=INBOX

# Optional LLM extraction (any OpenAI-compatible API). Empty = regex extractor only.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Ledger: sqlite (data/invoices.db) | csv (data/ledger.csv) | google_sheets
SINK=sqlite
GOOGLE_SHEETS_WEBHOOK_URL=

# Alerts: console (data/alerts.log) | slack
NOTIFIER=console
SLACK_WEBHOOK_URL=

# Business rules
AMOUNT_SPIKE_FACTOR=3
MAX_AUTO_APPROVE_AMOUNT=5000

# Reliability / scheduling
RETRY_ATTEMPTS=4
RETRY_BASE_DELAY_MS=500
WATCH_INTERVAL_MS=10000
